{
  "name": "ljr",
  "version": "0.1.0",
  "private": true,
  "description": "律聚人 monorepo（产品代码根；需求与设计的唯一事实源在 docs/）",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "gen:table-manifest": "node scripts/gen-table-manifest.mjs",
    "check:schema-refs": "node scripts/check-schema-refs.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "js-yaml": "^5.4.3",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}

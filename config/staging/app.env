# config/staging/app.env —— staging 骨架（M0-8；A3 降级：staging 部署后移 M1）
# 当前无云资源（用户 2026-10-13 确认）：下列地址为结构性占位（*.internal 无实际解析），
# M1 落地部署时按实际拓扑替换。文件层只放非敏感项——连接地址与端口可入库；
# 账号口令/Token 一律进程环境注入（平台 secrets，见 ../README.md §secrets）。
# 注意：staging 起 LJR_PG_PASSWORD 缺失会启动失败（E_CONFIG_MISSING，fail-fast）。
PORT=3000
LJR_PG_HOST=staging-pg.internal
LJR_PG_PORT=5432
LJR_PG_USER=ljr_app_staging
LJR_PG_DB=ljr_staging
LJR_REDIS_HOST=staging-redis.internal
LJR_REDIS_PORT=6379
LJR_ROCKETMQ_NAMESRV_ADDR=staging-mq.internal:9876
LJR_NACOS_SERVER_ADDR=staging-nacos.internal:8848

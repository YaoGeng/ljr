# config/dev/app.env —— dev 环境非敏感默认值（M0-8）
# 分层优先级：进程 env > 本文件 > 代码默认值（services/core/src/config/app.config.ts）。
# 本文件刻意与代码默认值同值（dev 便携轨口径）：作用是把「可入库的默认值」显式化，
# 环境差异从 dev 起就有文件层可写，而非 env 或改代码。
# 密钥禁入：LJR_PG_PASSWORD / LJR_REDIS_PASSWORD / LJR_ENV 出现在本文件会让启动直接失败
#（E_CONFIG_INVALID，防真实凭据借示例名入库——见 ../README.md）。
PORT=3000
LJR_PG_HOST=127.0.0.1
LJR_PG_PORT=5435
LJR_PG_USER=postgres
LJR_PG_DB=ljr_dev
LJR_REDIS_HOST=127.0.0.1
LJR_REDIS_PORT=6380
LJR_ROCKETMQ_NAMESRV_ADDR=127.0.0.1:9876
LJR_NACOS_SERVER_ADDR=127.0.0.1:8848
# OTel 装配总开关（M0-9）：false = 不注册 provider/不插桩 http+pg/日志不注入 trace_id。
# OTLP 接收端走 OTel 标准键 OTEL_EXPORTER_OTLP_ENDPOINT（仅进程 env，见
# services/core/src/observability/otel.setup.ts）；未设时装配降级为 noop 处理器，本地零开销。
LJR_OBS_ENABLED=true

# config/prod/app.env —— prod 骨架（M0-8）
# 结构性占位：prod 拓扑由部署平台管理（地址经平台注入 env 或届时替换本文件的非敏感项）。
# 红线：任何密钥（数据库口令/Redis 口令/Nacos Token/API Key）禁入本文件与仓库任何位置
#（架构 §1.3；gitleaks 全历史扫描兜底）；prod 的 LJR_PG_PASSWORD 缺失=启动失败（fail-fast）。
PORT=3000
LJR_PG_HOST=prod-pg.internal
LJR_PG_PORT=5432
LJR_PG_USER=ljr_app_prod
LJR_PG_DB=ljr_prod
LJR_REDIS_HOST=prod-redis.internal
LJR_REDIS_PORT=6379
LJR_ROCKETMQ_NAMESRV_ADDR=prod-mq.internal:9876
LJR_NACOS_SERVER_ADDR=prod-nacos.internal:8848
